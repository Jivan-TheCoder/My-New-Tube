<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_permission_dialog_card"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/img_overlay" />

        <TextView
            android:id="@+id/overlayDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:text="@string/permission_display_over_apps"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/overlayDialogClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cancel"
            android:paddingStart="22dp"
            android:paddingBottom="22dp"
            android:src="@drawable/ic_close"
            app:tint="?android:attr/textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlayDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="62dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="55dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/permission_display_over_apps_message"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlayDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/cancel"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayDialogOk"
            android:layout_width="78dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_permission_dialog_positive_button"
            android:gravity="center"
            android:text="@string/ok"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
